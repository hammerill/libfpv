# Writes the build references shown in the overlay's About tab (OUT, a .cpp
# implementing src/util/build_info.h). Runs in script mode on every build
# (cmake -P), and rewrites OUT only when its content changed, so an unchanged
# tree recompiles nothing.
#   -DSRC=<libfpv source dir> -DOUT=<file> -DVERSION=<project version>
#   -DBF_DIR=<betaflight dir> -DSIMITL_DIR=<SimITL dir>
# The build date has day precision (UTC, or SOURCE_DATE_EPOCH): a finer one
# would relink libfpv on every build.

# The commit of the git repository rooted exactly at dir: libfpv vendored
# inside a game's repository (or a submodule copied without .git) would
# otherwise report the game's commit. Sets <prefix>_HASH, _DIRTY, _DATE.
function(libfpv_git_ref dir prefix)
  set(${prefix}_HASH "unknown" PARENT_SCOPE)
  set(${prefix}_DIRTY 0 PARENT_SCOPE)
  set(${prefix}_DATE "" PARENT_SCOPE)
  find_program(_git git)
  if(NOT _git OR NOT IS_DIRECTORY "${dir}")
    return()
  endif()
  execute_process(COMMAND "${_git}" rev-parse --show-toplevel WORKING_DIRECTORY "${dir}"
    OUTPUT_VARIABLE _top OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _res ERROR_QUIET)
  if(NOT _res EQUAL 0)
    return()
  endif()
  file(REAL_PATH "${_top}" _top)
  file(REAL_PATH "${dir}" _dir)
  if(NOT _top STREQUAL _dir)
    return()
  endif()
  execute_process(COMMAND "${_git}" log -1 --format=%H%n%cs WORKING_DIRECTORY "${dir}"
    OUTPUT_VARIABLE _log OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _res ERROR_QUIET)
  if(NOT _res EQUAL 0)
    return()
  endif()
  string(REPLACE "\n" ";" _log "${_log}")
  list(GET _log 0 _hash)
  list(GET _log 1 _date)
  set(${prefix}_HASH "${_hash}" PARENT_SCOPE)
  set(${prefix}_DATE "${_date}" PARENT_SCOPE)
  # tracked changes only; .gitmodules keeps the patched submodules out
  execute_process(COMMAND "${_git}" status --porcelain --untracked-files=no WORKING_DIRECTORY "${dir}"
    OUTPUT_VARIABLE _status RESULT_VARIABLE _res ERROR_QUIET)
  if(_res EQUAL 0 AND NOT _status STREQUAL "")
    set(${prefix}_DIRTY 1 PARENT_SCOPE)
  endif()
endfunction()

libfpv_git_ref("${SRC}" FPV)
libfpv_git_ref("${BF_DIR}" BF)
libfpv_git_ref("${SIMITL_DIR}" SIMITL)
# libfpv's patch series always leaves them changed: shown as a patch count
set(BF_DIRTY 0)
set(SIMITL_DIRTY 0)
file(GLOB _bf_patches "${SRC}/patches/betaflight/*.patch")
file(GLOB _simitl_patches "${SRC}/patches/simitl/*.patch")
list(LENGTH _bf_patches BF_PATCHES)
list(LENGTH _simitl_patches SIMITL_PATCHES)
string(TIMESTAMP BUILD_DATE "%Y-%m-%d" UTC)

set(_content "// Generated by cmake/BuildInfo.cmake on every build. Do not edit.
#include \"util/build_info.h\"

namespace fpv {

const BuildInfo &buildInfo() {
    static const BuildInfo info{
        \"${VERSION}\",
        {\"${FPV_HASH}\", ${FPV_DIRTY} != 0, \"${FPV_DATE}\"},
        {\"${BF_HASH}\", ${BF_DIRTY} != 0, \"${BF_DATE}\"},
        {\"${SIMITL_HASH}\", ${SIMITL_DIRTY} != 0, \"${SIMITL_DATE}\"},
        ${BF_PATCHES},
        ${SIMITL_PATCHES},
        \"${BUILD_DATE}\",
    };
    return info;
}

}  // namespace fpv
")
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUT}" "${_content}")
endif()
