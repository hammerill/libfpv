+// provides access to betaflight internals
+// used by SimITL
+
+#ifndef SITL_BF
+#define SITL_BF
+
+namespace SimITL{
+  namespace BF {
+    extern "C" {
+      #include "common/maths.h"
+
+      #include "fc/init.h"
+      #include "fc/runtime_config.h"
+      #include "fc/tasks.h"
