+// libfpv: every simulated ESC sends its rpm back, like bidirectional DShot
+// (simSetMotorRpm), whatever the motor protocol
+bool useDshotTelemetry = true;
+
+#ifdef USE_DSHOT_TELEMETRY
+// The telemetry frame an ESC would send for a motor at `rpm`: the
+// electrical period in microseconds as GCR "eeem mmmm mmmm" (0x0fff when
+// stopped). Betaflight decodes it with the pole count it is configured with.
+static uint16_t erpmTelemetryValue(float rpm)
+{
+    const float erpm = fabsf(rpm) * motorConfig()->motorPoleCount / 2.0f;
+    if (erpm < 100.0f) {
+        return 0x0fff;
+    }
+    uint32_t period = (uint32_t)lrintf(60e6f / erpm);
+    uint32_t e = 0;
+    while (period > 0x1ff && e < 7) {
+        period >>= 1;
+        e++;
+    }
+    if (period > 0x1ff) {
+        return 0x0fff;
+    }
+    return (uint16_t)((e << 9) | period);
+}
+
+// DShot itself has no simulated driver: the motors run on PWM (libfpv's
+// default protocol) and only the telemetry is DShot's.
+dshotTelemetryCycleCounters_t dshotDMAHandlerCycleCounters;
+
+bool dshotPwmDevInit(motorDevice_t *device, const motorDevConfig_t *motorConfig)
+{
+    UNUSED(device);
+    UNUSED(motorConfig);
+    return false;
+}
+
+void simSetMotorRpm(const float *rpm, int count)
+{
+    for (int i = 0; i < count && i < MAX_SUPPORTED_MOTORS; i++) {
+        dshotTelemetryState.motorState[i].rawValue = erpmTelemetryValue(rpm[i]);
+    }
+    dshotTelemetryState.rawValueState = DSHOT_RAW_VALUE_STATE_NOT_PROCESSED;
+}
+#else
+void simSetMotorRpm(const float *rpm, int count)
+{
+    UNUSED(rpm);
+    UNUSED(count);
+}
+#endif
