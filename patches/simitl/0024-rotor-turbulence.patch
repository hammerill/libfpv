   constexpr float ESC_START_TIME = 0.12f;   // s
   constexpr float ESC_STOPPED_RPM = 300.0f;
 
+  // libfpv: the unsteady thrust (stateInit.rotorTurbulence) is a
+  // Gauss-Markov process per rotor with this correlation time: most of its
+  // power below about 10 Hz, where a quad's rate loop feels it as bumps.
+  constexpr float ROTOR_TURBULENCE_TIME = 0.06f;  // s
+
+  // a standard normal sample
+  static float randn() {
+    float u1 = std::max(static_cast<float>(rand()) / static_cast<float>(RAND_MAX), 1e-7f);
+    float u2 = static_cast<float>(rand()) / static_cast<float>(RAND_MAX);
+    return std::sqrt(-2.0f * std::log(u1)) * std::cos(2.0f * float(M_PI) * u2);
+  }
+
   // libfpv: share of static thrust left at an axial inflow of `vel` m/s
   // (climbing, positive). Measured small-prop thrust coefficients follow
   // CT(J) ~ CT0 * (1 - (J / J0)^2), with zero thrust (J0) at about 0.9 of the
@@ -710,6 +722,12 @@ float Physics::motorTorque(float volts, float rpm, float kV, float R, float I0)
       float thrust = propThrust(rpm, vel) *
                      ductThrustFactor(mSimState->stateInit.ductThrustGain, mSimState->stateInit.propPitch, rpm, vel) *
                      propHealthFactor * groundEffect * propwashEffect * propDamageEffect;
+      // libfpv: unsteady inflow
+      if (mSimState->stateInit.rotorTurbulence > 0.0f) {
+        const float a = std::min(1.0f, static_cast<float>(dt) / ROTOR_TURBULENCE_TIME);
+        motors[i].turbulence += -motors[i].turbulence * a + std::sqrt(2.0f * a) * randn();
+        thrust *= std::max(0.0f, 1.0f + mSimState->stateInit.rotorTurbulence * motors[i].turbulence);
+      }
       // a prop spun backwards pushes the other way, with a less efficient
       // (inverted) airfoil
       const float spinDir = state.motorsReversed ? -1.0f : 1.0f;
