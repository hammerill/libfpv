diff --git a/src/main/drivers/motor.c b/src/main/drivers/motor.c
index 2fa45124c..ca3b9b020 100644
--- a/src/main/drivers/motor.c
+++ b/src/main/drivers/motor.c
@@ -328,7 +328,12 @@ void motorEnable(void)
 {
