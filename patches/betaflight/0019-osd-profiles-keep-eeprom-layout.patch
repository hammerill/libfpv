+#if OSD_PROFILE_COUNT > 1
+    char profileMore[OSD_PROFILE_COUNT - 1][OSD_PROFILE_NAME_LENGTH + 1]; // names of OSD profiles 2 and up
+#endif
 } osdConfig_t;
 
+// The name buffer of OSD profile index (0-based) i.
+#if OSD_PROFILE_COUNT > 1
+#define OSD_PROFILE_NAME_BUF(cfg, i) ((i) == 0 ? (cfg)->profile[0] : (cfg)->profileMore[(i) - 1])
+#else
+#define OSD_PROFILE_NAME_BUF(cfg, i) ((cfg)->profile[0])
+#endif
+
 PG_DECLARE(osdConfig_t, osdConfig);
 
