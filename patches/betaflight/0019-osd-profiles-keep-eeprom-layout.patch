diff --git a/src/main/osd/osd.h b/src/main/osd/osd.h
index 58d4a8322..f2fe4968b 100644
--- a/src/main/osd/osd.h
+++ b/src/main/osd/osd.h
@@ -333,7 +333,10 @@ typedef struct osdConfig_s {
     uint8_t ahInvert;                         // invert the artificial horizon
     uint8_t osdProfileIndex;
     uint8_t overlay_radio_mode;
-    char profile[OSD_PROFILE_COUNT][OSD_PROFILE_NAME_LENGTH + 1];
+    // libfpv: only OSD profile 1's name stays here; the others are in
+    // profileMore at the end, so EEPROMs saved by builds with one OSD
+    // profile keep their layout. Use OSD_PROFILE_NAME_BUF().
+    char profile[1][OSD_PROFILE_NAME_LENGTH + 1];
     uint16_t link_quality_alarm;
     int16_t rssi_dbm_alarm;
     int16_t rsnr_alarm;
@@ -363,8 +366,18 @@ typedef struct osdConfig_s {
