// libfpv - VERSIONINFO for libfpv's Windows binaries: the Details tab of a
// file's Properties, and what antivirus heuristics read (an unsigned DLL
// with no version info scores as more suspicious; docs/INTEGRATION.md,
// "Version info in the binaries"). The including .rc defines
// LIBFPV_RC_FILE_DESCRIPTION, LIBFPV_RC_FILE_NAME, LIBFPV_RC_LICENSE and
// LIBFPV_RC_FILE_TYPE; build_info_rc.h comes from cmake/BuildInfo.cmake.
// SPDX-License-Identifier: GPL-3.0-or-later OR MIT
#include <winver.h>
#include "build_info_rc.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     LIBFPV_RC_VERSION_NUMBERS
PRODUCTVERSION  LIBFPV_RC_VERSION_NUMBERS
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        LIBFPV_RC_FILE_TYPE
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "libfpv"
      VALUE "FileDescription",  LIBFPV_RC_FILE_DESCRIPTION
      VALUE "FileVersion",      LIBFPV_RC_VERSION
      VALUE "InternalName",     LIBFPV_RC_FILE_NAME
      VALUE "OriginalFilename", LIBFPV_RC_FILE_NAME
      VALUE "ProductName",      "libfpv"
      VALUE "ProductVersion",   LIBFPV_RC_VERSION
      VALUE "LegalCopyright",   "Copyright (c) 2026 libfpv contributors. " LIBFPV_RC_LICENSE
      VALUE "Comments",         "FPV drone simulator for games, running real Betaflight firmware. https://libfpv.com"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
